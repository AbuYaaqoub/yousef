{
  "manifest_version": 3,
  "name": "SEMrush Smart Copier",
  "version": "1.0.0",
  "description": "نسخ جداول SEMrush بشكل مرتب مباشرة إلى Excel",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.semrush.com/*",
    "https://*.proseotools.us/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.semrush.com/*",
        "https://*.proseotools.us/*"
      ],
      "js": ["content/index.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SEMrush Smart Copier"
  }
}
